    "sample-case-live-005": {
      "meta": {
        "id": "IR-2026-042",
        "title": "Cloud identity compromise — OAuth token theft (M365 / Azure)",
        "severity": "high",
        "status": "in-progress",
        "owner": "Dan H",
        "detectedAt": "2026-09-27T13:40",
        "reportedAt": "2026-09-27T14:00",
        "containedAt": "",
        "resolvedAt": "",
        "classification": "Cloud account compromise",
        "systems": "Entra ID tenant, EXO mailbox (a.okafor@), SharePoint Online (Finance site), WKS-DEV11 (developer workstation), Azure subscription (prod-sub-01)",
        "containment": "",
        "narrative": "An active intrusion into the organisation's Microsoft 365 / Azure tenant is under investigation. On 27 September an adversary-in-the-middle phishing page harvested a session token for a developer account (a.okafor@), bypassing MFA. The actor established OAuth-based persistence by consenting a malicious enterprise application, then used the mailbox and SharePoint access to enumerate finance content. Over the last 24 hours the actor has escalated: additional sign-ins from new infrastructure, a hidden inbox rule, an attempt to add credentials to an Azure service principal, and the beginnings of data staging in SharePoint. Containment is in progress at time of this report — the compromised session and the malicious OAuth grant have been revoked, but the investigation into blast radius across the subscription is ongoing and not all remediation is complete."
      },
      "govern": {
        "assets": "Entra ID tenant, EXO, SharePoint Online, Azure prod-sub-01, WKS-DEV11",
        "criticality": "Tier 1 — business critical",
        "dataClass": "Confidential",
        "dataTypes": "Finance documents, limited employee PII, source-code repository links",
        "regs": "UK GDPR / DPA 2018",
        "notifDeadline": "2026-09-30T13:40",
        "deadlineBasis": "UK GDPR Art.33 — 72h from detection (PII exposure under assessment)",
        "legalNotes": "External counsel engaged. ICO notification under assessment pending confirmation of PII access. Privilege asserted over technical report.",
        "commander": "Dan H (Head of IR)",
        "legal": "Eleanor Voss (General Counsel)",
        "dpo": "Raj Patel (DPO)",
        "sponsor": "Helena Marsh (CISO)",
        "comms": "Tom Reilly (Head of Comms)",
        "externalIR": "",
        "secureComms": "Signal bridge — tenant assumed monitored by actor until token revocation confirmed",
        "bizImpact": "No outage. Finance SharePoint content accessed; exfiltration attempted but not confirmed complete. Response effort ongoing; cost not yet estimated.",
        "repRisk": "Medium — contained to one tenant identity so far; no external disclosure required at this stage.",
        "insurance": "Cyber policy CYB-88213 (Beazley). Insurer notified; claim reference pending.",
        "riskNotes": "Active incident. Primary risk is undiscovered persistence (additional OAuth grants / service-principal credentials) and lateral movement into the Azure subscription. Blast-radius review in progress."
      },
